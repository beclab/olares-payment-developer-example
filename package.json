{
  "name": "olares-payment-user-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mode A shop demo: MerchantClient createPayment + webhook fulfillment",
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap-merchant.ts",
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@olares/payment-sdk": "file:./vendor/payment-sdk",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue": "^3.5.13"
  }
}
