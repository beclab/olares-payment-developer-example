# Payment gateway (HMAC API)
PAYMENT_ENDPOINT=http://127.0.0.1:31000
PAYMENT_API_KEY=
PAYMENT_API_SECRET=

# Webhook signing secret (whsec_...). The URL itself is registered on the
# payment side (notify_webhook_endpoints), not sent from this shop.
WEBHOOK_SECRET=

# This shop
PORT=32000
SHOP_PUBLIC_URL=http://127.0.0.1:32001

# Only used by scripts/bootstrap-merchant.ts (temporary; will be replaced by dashboard).
# Leave empty to read ../olares-payment/packages/payment/.env or the default local URL.
DATABASE_URL=
